{
  "name": "draken",
  "version": "0.1.6",
  "description": "Local-first engineering sync across pi coding sessions",
  "main": "dist/server.js",
  "bin": {
    "draken": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "npm run build:server && node --test tests/*.test.cjs",
    "test:ui": "npm run build && playwright test",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "dev": "tsc -w",
    "dev:client": "cd client && npm run dev",
    "voice:setup": "node voice/setup.mjs",
    "voice:tls": "node voice/tls.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "public/",
    "voice/worker.py",
    "voice/requirements.txt",
    "voice/setup.mjs",
    "voice/tls.mjs",
    "VOICE.md",
    "PERSONA.md"
  ],
  "keywords": [
    "pi",
    "ai",
    "sessions",
    "sync",
    "dashboard"
  ],
  "author": "mehanig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehanig/draken"
  },
  "homepage": "https://draken.mehanig.com",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
