{
  "name": "draken",
  "version": "0.6.0",
  "description": "Read-only summaries and discussion of your coding-agent sessions",
  "main": "dist/server.js",
  "bin": {
    "draken": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc --noEmit && npm --prefix client run typecheck",
    "lint:unused": "knip",
    "check": "npm run typecheck && npm run lint:unused",
    "build:server": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "npm run build:server && node --test tests/*.test.cjs",
    "test:ui": "npm run build && playwright test",
    "build:client": "cd client && npm run build",
    "start": "node dist/server.js",
    "dev": "tsc -w",
    "dev:client": "cd client && npm run dev",
    "voice:tls": "node voice/tls.mjs",
    "voice:realtime:setup": "node voice/realtime/setup.mjs --install",
    "voice:realtime:login": "node voice/realtime/setup.mjs --login",
    "voice:realtime:check": "node voice/realtime/probe.mjs --check",
    "voice:realtime:probe": "node voice/realtime/probe.mjs",
    "test:realtime:browser": "node --test tests/realtime-browser.cjs",
    "test:realtime:native": "node tests/realtime-native.cjs",
    "test:live:browser": "node --test tests/live-browser.cjs",
    "test:live:real": "node tests/live-voice-real.cjs",
    "test:memory:local": "node tests/memory-real.cjs",
    "test:tray:native": "node tests/tray-native.cjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "public/",
    "tray/macos.js",
    "tray/windows.ps1",
    "tray/assets/*.png",
    "tray/assets/*.ico",
    "TRAY.md",
    "voice/tls.mjs",
    "runtime/pi/package.json",
    "runtime/pi/package-lock.json",
    "voice/realtime/",
    "tests/fixtures/voice-question.wav",
    "VOICE.md",
    "PERSONA.md",
    "MEMORY.md",
    "SOURCES.md",
    "SETUP.md",
    "ACCEPTANCE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi",
    "ai",
    "sessions",
    "sync",
    "dashboard"
  ],
  "author": "mehanig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehanig/draken"
  },
  "homepage": "https://draken.mehanig.com",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "gpt-tokenizer": "4.1.0",
    "jsonwebtoken": "^9.0.3",
    "onnxruntime-web": "1.24.3",
    "proper-lockfile": "4.1.2",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "knip": "6.44.1",
    "typescript": "^5.7.3"
  }
}
