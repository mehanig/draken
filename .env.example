# Local development. Export these variables; Draken does not auto-load .env.
# Loopback needs no login by default; no auth variables are required.
DRAKEN_HOST=127.0.0.1
DRAKEN_PORT=40333

# Optional paths (use absolute paths, not a quoted literal ~)
# DRAKEN_DATA_DIR=/home/you/.draken
# DRAKEN_PI_SESSIONS_DIR=/home/you/.pi/agent/sessions
# DRAKEN_PI_BIN=/home/you/.local/bin/pi
# Server-side model defaults; override only if needed. No model settings in the UI.
# Confirm that your pi account can access these models.
# DRAKEN_PI_SUMMARY_MODEL=openai/gpt-6-luna
# DRAKEN_PI_FINAL_MODEL=openai/gpt-6-astra
# DRAKEN_PI_MODEL=provider/model # Legacy final-model fallback
DRAKEN_PI_MAX_INVOCATIONS=120
DRAKEN_PI_TIMEOUT_MS=180000

# Optional local speech: npm run voice:setup (no new voice API key).
# See VOICE.md for installation, privacy and browser requirements.
# DRAKEN_PI_VOICE_MODEL=openai/gpt-6-luna # Defaults to the sync's summary model
# DRAKEN_VOICE_DATA_DIR=/home/you/.draken/voice
# DRAKEN_VOICE_THREADS=4
# DRAKEN_VOICE_SPEAKER=af_heart

# Optional second HTTPS listener for LAN microphones.
# npm run voice:tls -- --host YOUR_LAN_IP prints the correct absolute paths.
# Trust your generated PUBLIC root certificate on the client device; keep keys private.
# DRAKEN_HTTPS_PORT=44433
# DRAKEN_TLS_CERT=/home/you/.draken/runtime/tls/draken-server.crt
# DRAKEN_TLS_KEY=/home/you/.draken/runtime/tls/draken-server.key
# DRAKEN_TLS_CA=/home/you/.draken/runtime/tls/draken-local-root.crt

# LAN/remote deployment: configure credentials, choose a bind address,
# and put Draken behind HTTPS. Non-loopback bindings require authentication.
# DRAKEN_NO_AUTH=false # Optional: also require login on loopback.
# DRAKEN_USERNAME=admin
# DRAKEN_PASSWORD=choose-a-strong-password
# DRAKEN_JWT_SECRET=generate-a-long-random-secret
