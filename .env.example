# Local development. Export these variables; Draken does not auto-load .env.
# Loopback needs no login by default; no auth variables are required.
DRAKEN_HOST=127.0.0.1
DRAKEN_PORT=40333

# Optional paths (use absolute paths, not a quoted literal ~)
# DRAKEN_DATA_DIR=/home/you/.draken
# DRAKEN_PI_SESSIONS_DIR=/home/you/.pi/agent/sessions
# DRAKEN_PI_BIN=/home/you/.local/bin/pi
# Choose models here or per sync in the UI. Summary selection is required;
# there is no silent fallback to an expensive model. Confirm account access.
# DRAKEN_PI_SUMMARY_MODEL=provider/cheap-model
# DRAKEN_PI_FINAL_MODEL=provider/strong-model
# DRAKEN_PI_MODEL=provider/model # Legacy final-model fallback
DRAKEN_PI_MAX_INVOCATIONS=120
DRAKEN_PI_TIMEOUT_MS=180000

# LAN/remote deployment: configure credentials, choose a bind address,
# and put Draken behind HTTPS. Non-loopback bindings require authentication.
# DRAKEN_NO_AUTH=false # Optional: also require login on loopback.
# DRAKEN_USERNAME=admin
# DRAKEN_PASSWORD=choose-a-strong-password
# DRAKEN_JWT_SECRET=generate-a-long-random-secret
